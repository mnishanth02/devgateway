# Railway variable convention example
# Apply as Railway environment variables only after review. This file is not a provisioning script.
# Secret-free placeholders only; production provisioning is explicitly disabled by default.

# Environment controls (public/internal)
APP_ENV=development
RAILWAY_ENVIRONMENT=development
PRODUCTION_PROVISIONING_ENABLED=false
PRODUCTION_DEPLOY_APPROVAL_REQUIRED=true

# Better Auth (public/secret)
BETTER_AUTH_URL=https://<service-domain>
BETTER_AUTH_SECRET=<secret:railway-generated-better-auth-secret>
BETTER_AUTH_TRUSTED_ORIGINS=https://<admin-domain>,https://<api-domain>
AUTH_ADMIN_BOOTSTRAP_ENABLED=false
AUTH_ADMIN_BOOTSTRAP_EMAIL=<internal:admin@example.invalid>

# Databases: use Railway service reference variables where available (secret)
OPERATIONAL_DATABASE_URL=${{OperationalPostgres.DATABASE_URL}}
KNOWLEDGE_DATABASE_URL=${{KnowledgePostgres.DATABASE_URL}}
DATABASE_MIGRATION_URL=<secret:migration-role-database-url>
DATABASE_READONLY_URL=<secret:readonly-role-database-url>

# Retrieval strategy controls and Neo4j GraphRAG (internal/secret)
RETRIEVAL_PRODUCTION_ENABLED=false
RETRIEVAL_LEXICAL_ENABLED=true
RETRIEVAL_EMBEDDINGS_ENABLED=true
RETRIEVAL_RERANKER_ENABLED=true
RETRIEVAL_GRAPH_RAG_ENABLED=true
RETRIEVAL_NEO4J_ENABLED=true
RETRIEVAL_CONTEXT_BUDGETER_ENABLED=true
RETRIEVAL_CONTEXT_COMPRESSOR_ENABLED=true
RETRIEVAL_CODE_EMBEDDINGS_ENABLED=false
RETRIEVAL_EVAL_STRATEGIES=hybrid,hybrid_graph
RETRIEVAL_MAX_CONTEXT_TOKENS=24000
RETRIEVAL_MAX_SNIPPET_TOKENS=1200
NEO4J_URI=${{Neo4j.NEO4J_URI}}
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<secret:neo4j-password>
NEO4J_DATABASE=neo4j

# Redis: use Railway Redis reference variables where available (secret/internal)
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_QUEUE_NAMESPACE=devgateway:queue:${{RAILWAY_ENVIRONMENT_NAME}}
REDIS_RATE_LIMIT_NAMESPACE=devgateway:ratelimit:${{RAILWAY_ENVIRONMENT_NAME}}

# Bifrost/provider (secret/internal)
BIFROST_BASE_URL=https://<bifrost-service-domain>
BIFROST_ADMIN_TOKEN=<secret:bifrost-admin-token>
BIFROST_VIRTUAL_KEY_SEED=<secret:virtual-key-seed>
BIFROST_CONFIG_PATH=/etc/devgateway/bifrost.evidence.json
BIFROST_RUNTIME_CONFIG_PATH=/etc/devgateway/config.runtime.json
BIFROST_CONTAINER_CONFIG_PATH=/app/data/config.json
BIFROST_ROUTE_CONFIG_VERSION=<internal:registry-snapshot-version>
BIFROST_POLICY_VERSION=<internal:policy-snapshot-version>
BIFROST_BREAK_GLASS_ENABLED=false
DEVGATEWAY_OPENAI_API_KEY_PLACEHOLDER=<secret:provider-key-placeholder>
DEVGATEWAY_ANTHROPIC_API_KEY_PLACEHOLDER=<secret:provider-key-placeholder>

# GitHub App (secret/internal)
GITHUB_APP_ID=<internal:github-app-id>
GITHUB_APP_INSTALLATION_ID=<internal:github-app-installation-id>
GITHUB_APP_PRIVATE_KEY_BASE64=<secret:base64-pem-placeholder>
GITHUB_APP_WEBHOOK_SECRET=<secret:webhook-secret-placeholder>

# Object storage / Railway bucket or S3-compatible service (secret/internal)
S3_ENDPOINT=${{ArtifactsBucket.S3_ENDPOINT}}
S3_BUCKET=${{ArtifactsBucket.S3_BUCKET}}
S3_REGION=${{ArtifactsBucket.S3_REGION}}
S3_ACCESS_KEY_ID=${{ArtifactsBucket.S3_ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{ArtifactsBucket.S3_SECRET_ACCESS_KEY}}
S3_FORCE_PATH_STYLE=true

# Observability (public/internal/secret)
OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-collector-domain>
OTEL_EXPORTER_OTLP_HEADERS=<secret:otlp-header-placeholder>
OTEL_SERVICE_NAME=<service-name>
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=${{RAILWAY_ENVIRONMENT_NAME}}
TRACE_SAMPLE_RATE=0.10
METRICS_EXPORT_MODE=otel

# Eval gates (internal)
EVAL_DATASET_PATH=evals/fixtures
EVAL_GATE_MODE=fixture
EVAL_ARTIFACT_BUCKET=${{ArtifactsBucket.S3_BUCKET}}
EVAL_PROVIDER_MODE=fixture
EVAL_SMOKE_ENABLED=true

# Application encryption and audit correlation (secret/internal)
APP_ENCRYPTION_KEY_BASE64=<secret:32-byte-base64-key-placeholder>
CREDENTIAL_KEY_VERSION=railway-dev-v1
CREDENTIAL_ROTATION_REQUIRED=false
AUDIT_CORRELATION_SALT=<secret:audit-salt-placeholder>
