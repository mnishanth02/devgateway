{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    ".npmrc"
  ],
  "globalPassThroughEnv": [
    "AGENT_RUNTIME_POSTGRES_TEST_URL",
    "DATABASE_CHECK_URL",
    "DATABASE_MIGRATION_URL"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:durable:postgres": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:durable:chaos": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "eval:smoke": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "db:check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "registry:validate": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "policy:validate": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
