{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json",
  "title": "DevGateway Anthropic-Compatible External Contracts v0.1",
  "$defs": {
    "model": {
      "type": "object",
      "required": ["id", "type", "display_name", "created_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "model" },
        "display_name": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "getModelsResponse": {
      "type": "object",
      "required": ["data", "has_more"],
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "#/$defs/model" }
        },
        "has_more": { "type": "boolean" },
        "first_id": { "type": ["string", "null"] },
        "last_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "contentBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "image", "tool_use", "tool_result", "thinking", "redacted_thinking"]
        },
        "text": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "tool_use_id": { "type": "string" },
        "content": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/contentBlock" }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "input_schema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "input_schema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "messagesRequest": {
      "type": "object",
      "required": ["model", "max_tokens", "messages"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        },
        "system": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/contentBlock" }
            }
          ]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "stop_sequences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stream": { "type": "boolean" },
        "temperature": { "type": "number", "minimum": 0 },
        "top_k": { "type": "integer", "minimum": 0 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool" }
        },
        "tool_choice": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "name": { "type": "string" },
            "disable_parallel_tool_use": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "thinking": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "budget_tokens": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "service_tier": { "type": "string" }
      },
      "additionalProperties": false
    },
    "messagesResponse": {
      "type": "object",
      "required": ["id", "type", "role", "content", "model", "stop_reason", "stop_sequence", "usage"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "message" },
        "role": { "const": "assistant" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentBlock" }
        },
        "model": { "type": "string", "minLength": 1 },
        "stop_reason": {
          "type": ["string", "null"],
          "enum": ["end_turn", "max_tokens", "stop_sequence", "tool_use", "pause_turn", "refusal", null]
        },
        "stop_sequence": { "type": ["string", "null"] },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "additionalProperties": false
    },
    "messagesStreamEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message_start",
            "content_block_start",
            "content_block_delta",
            "content_block_stop",
            "message_delta",
            "message_stop",
            "ping",
            "error"
          ]
        },
        "message": {
          "type": "object",
          "additionalProperties": true
        },
        "index": { "type": "integer", "minimum": 0 },
        "content_block": { "$ref": "#/$defs/contentBlock" },
        "delta": {
          "type": "object",
          "additionalProperties": true
        },
        "usage": { "$ref": "#/$defs/usage" },
        "error": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "countTokensRequest": {
      "type": "object",
      "required": ["model", "messages"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        },
        "system": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/contentBlock" }
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool" }
        },
        "thinking": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "budget_tokens": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "countTokensResponse": {
      "type": "object",
      "required": ["input_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
