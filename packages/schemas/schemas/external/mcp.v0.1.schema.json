{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json",
  "title": "DevGateway MCP External Endpoint and Async Tool Contracts v0.1",
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": true },
        { "type": "object", "additionalProperties": true }
      ]
    },
    "jsonRpcId": {
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "null" }
      ]
    },
    "jsonRpcRequest": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "method": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "jsonRpcResponse": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/jsonRpcId" },
        "result": { "$ref": "#/$defs/jsonValue" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string", "minLength": 1 },
            "data": { "$ref": "#/$defs/jsonValue" }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [{ "required": ["result"] }, { "required": ["error"] }],
      "additionalProperties": false
    },
    "streamableHttpRequest": {
      "oneOf": [
        { "$ref": "#/$defs/jsonRpcRequest" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/jsonRpcRequest" }
        }
      ]
    },
    "streamableHttpResponse": {
      "oneOf": [
        { "$ref": "#/$defs/jsonRpcResponse" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/jsonRpcResponse" }
        }
      ]
    },
    "sseEvent": {
      "type": "object",
      "required": ["event", "data"],
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string", "enum": ["endpoint", "message", "ping", "error"] },
        "data": { "type": "string" },
        "retry": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "messagesRequest": {
      "$ref": "#/$defs/streamableHttpRequest"
    },
    "messagesResponse": {
      "type": "object",
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "boolean" },
        "message_id": { "type": "string" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "taskState": {
      "type": "string",
      "enum": [
        "queued",
        "planning",
        "running",
        "waiting_for_approval",
        "cancel_requested",
        "cancelled",
        "failed",
        "succeeded"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "costSoFar": {
      "type": "object",
      "required": ["amount_usd"],
      "properties": {
        "amount_usd": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pendingApproval": {
      "type": "object",
      "required": ["approval_id", "reason", "risk_tier"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "risk_tier": {
          "type": "string",
          "enum": ["read_only", "write_project", "external_side_effect", "privileged_operator"]
        }
      },
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "required": ["source_id", "uri"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "span": {
          "type": "object",
          "properties": {
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "type", "size_bytes", "sensitivity_label"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sensitivity_label": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "download_url": { "type": "string" },
        "download_url_expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "startBackgroundTaskInput": {
      "type": "object",
      "required": ["objective"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "repository": { "type": "string" },
        "context_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "model_alias": { "type": "string" },
        "budget": { "$ref": "#/$defs/budget" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "startBackgroundTaskOutput": {
      "type": "object",
      "required": ["task_id", "workflow_id", "status", "estimated_budget", "artifact_root"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/taskState" },
        "estimated_budget": { "$ref": "#/$defs/budget" },
        "artifact_root": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "checkTaskStatusInput": {
      "type": "object",
      "required": ["task_id"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "checkTaskStatusOutput": {
      "type": "object",
      "required": [
        "task_id",
        "status",
        "progress_summary",
        "pending_approvals",
        "cost_so_far",
        "latest_event_at"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/taskState" },
        "progress_summary": { "type": "string" },
        "pending_approvals": {
          "type": "array",
          "items": { "$ref": "#/$defs/pendingApproval" }
        },
        "cost_so_far": { "$ref": "#/$defs/costSoFar" },
        "latest_event_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "getTaskResultInput": {
      "type": "object",
      "required": ["task_id"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "include_partial": { "type": "boolean" },
        "include_artifacts": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "getTaskResultOutput": {
      "type": "object",
      "required": ["task_id", "status"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/taskState" },
        "synthesized_answer": { "type": "string" },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "failure": {
          "oneOf": [
            { "$ref": "#/$defs/failure" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "cancelTaskInput": {
      "type": "object",
      "required": ["task_id", "reason"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "cancelTaskOutput": {
      "type": "object",
      "required": ["task_id", "status", "cancellation_requested", "audit_event_id"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/taskState" },
        "cancellation_requested": { "type": "boolean" },
        "audit_event_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "listTaskArtifactsInput": {
      "type": "object",
      "required": ["task_id"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string" },
        "include_download_urls": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "listTaskArtifactsOutput": {
      "type": "object",
      "required": ["task_id", "artifacts"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    }
  }
}
