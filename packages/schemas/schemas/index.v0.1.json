    "policy_denial_reason": "https://devgateway.local/schemas/policy/denial-reason.v0.1.schema.json",
    "eval_case": "https://devgateway.local/schemas/eval/eval-case.v0.1.schema.json",
    "gate_definition": "https://devgateway.local/schemas/eval/gate-definition.v0.1.schema.json",
    "gate_result_persistence": "https://devgateway.local/schemas/eval/gate-result-persistence.v0.1.schema.json"
  },
  "endpoints": [
    {
      "provider": "openai",
      "method": "GET",
      "path": "/v1/models",
      "response_schema": "https://devgateway.local/schemas/external/openai.v0.1.schema.json#/$defs/getModelsResponse"
    },
    {
      "provider": "openai",
      "method": "POST",
      "path": "/v1/chat/completions",
      "request_schema": "https://devgateway.local/schemas/external/openai.v0.1.schema.json#/$defs/chatCompletionsRequest",
      "response_schema": "https://devgateway.local/schemas/external/openai.v0.1.schema.json#/$defs/chatCompletionsResponse",
      "stream_chunk_schema": "https://devgateway.local/schemas/external/openai.v0.1.schema.json#/$defs/chatCompletionsStreamChunk"
    },
    {
      "provider": "anthropic",
      "method": "GET",
      "path": "/v1/models",
      "response_schema": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json#/$defs/getModelsResponse"
    },
    {
      "provider": "anthropic",
      "method": "POST",
      "path": "/v1/messages",
      "request_schema": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json#/$defs/messagesRequest",
      "response_schema": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json#/$defs/messagesResponse",
      "stream_event_schema": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json#/$defs/messagesStreamEvent"
    },
    {
      "provider": "anthropic",
      "method": "POST",
      "path": "/v1/messages/count_tokens",
      "request_schema": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json#/$defs/countTokensRequest",
      "response_schema": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json#/$defs/countTokensResponse"
    },
    {
      "provider": "mcp",
      "method": "POST",
      "path": "/mcp",
      "request_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/streamableHttpRequest",
      "response_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/streamableHttpResponse"
    },
    {
      "provider": "mcp",
      "method": "GET",
      "path": "/mcp/sse",
      "event_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/sseEvent"
    },
    {
      "provider": "mcp",
      "method": "POST",
      "path": "/mcp/messages",
      "request_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/messagesRequest",
      "response_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/messagesResponse"
    }
  ],
  "async_mcp_tools": [
    {
      "name": "start_background_task",
      "input_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/startBackgroundTaskInput",
      "output_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/startBackgroundTaskOutput"
    },
    {
      "name": "check_task_status",
      "input_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/checkTaskStatusInput",
      "output_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/checkTaskStatusOutput"
    },
    {
      "name": "get_task_result",
      "input_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/getTaskResultInput",
      "output_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/getTaskResultOutput"
    },
    {
      "name": "cancel_task",
      "input_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/cancelTaskInput",
      "output_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/cancelTaskOutput"
    },
    {
      "name": "list_task_artifacts",
      "input_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/listTaskArtifactsInput",
      "output_schema": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json#/$defs/listTaskArtifactsOutput"
    }
  ],
