{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devgateway.local/schemas/index.v0.1.json",
  "title": "DevGateway Locked External Contract Schema Index v0.1",
  "contract_version": "0.1.0",
  "schemas": {
    "openai": "https://devgateway.local/schemas/external/openai.v0.1.schema.json",
    "anthropic": "https://devgateway.local/schemas/external/anthropic.v0.1.schema.json",
    "mcp": "https://devgateway.local/schemas/external/mcp.v0.1.schema.json",
    "gate_result": "https://devgateway.local/schemas/shared/gate-result.v0.1.schema.json",
    "virtual_key": "https://devgateway.local/schemas/shared/virtual-key.v0.1.schema.json",
    "budget_scope": "https://devgateway.local/schemas/shared/budget-scope.v0.1.schema.json",
    "cost_event": "https://devgateway.local/schemas/shared/cost-event.v0.1.schema.json",
    "trace_context": "https://devgateway.local/schemas/shared/trace-context.v0.1.schema.json",
    "provider_policy": "https://devgateway.local/schemas/policy/provider-policy.v0.1.schema.json",
