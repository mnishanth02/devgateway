    "gate_result": "https://devgateway.local/schemas/shared/gate-result.v0.1.schema.json#/$defs/gateResult",
    "gate_result_reference": "https://devgateway.local/schemas/shared/gate-result.v0.1.schema.json#/$defs/gateResultReference",
    "virtual_key": "https://devgateway.local/schemas/shared/virtual-key.v0.1.schema.json",
    "virtual_key_record": "https://devgateway.local/schemas/shared/virtual-key.v0.1.schema.json",
    "budget_scope": "https://devgateway.local/schemas/shared/budget-scope.v0.1.schema.json",
    "budget_scope_record": "https://devgateway.local/schemas/shared/budget-scope.v0.1.schema.json",
    "cost_event": "https://devgateway.local/schemas/shared/cost-event.v0.1.schema.json",
    "cost_event_record": "https://devgateway.local/schemas/shared/cost-event.v0.1.schema.json",
    "trace_context": "https://devgateway.local/schemas/shared/trace-context.v0.1.schema.json",
    "trace_context_record": "https://devgateway.local/schemas/shared/trace-context.v0.1.schema.json",
    "error": "https://devgateway.local/schemas/shared/gate-result.v0.1.schema.json#/$defs/error",
    "denial_reason_code": "https://devgateway.local/schemas/policy/denial-reason.v0.1.schema.json#/$defs/denialReasonCode",
    "denial_reason_definition": "https://devgateway.local/schemas/policy/denial-reason.v0.1.schema.json#/$defs/denialReasonDefinition",
    "denial_audit_context": "https://devgateway.local/schemas/policy/denial-reason.v0.1.schema.json#/$defs/denialAuditContext",
    "eval_dataset": "https://devgateway.local/schemas/eval/eval-case.v0.1.schema.json#/$defs/evalDataset",
    "eval_case": "https://devgateway.local/schemas/eval/eval-case.v0.1.schema.json#/$defs/standaloneEvalCase",
    "eval_dataset_case": "https://devgateway.local/schemas/eval/eval-case.v0.1.schema.json#/$defs/evalCase",
    "eval_fixture_ref": "https://devgateway.local/schemas/eval/eval-case.v0.1.schema.json#/$defs/fixtureRef",
    "gate_definition": "https://devgateway.local/schemas/eval/gate-definition.v0.1.schema.json#/$defs/gateDefinition",
    "gate_suite_thresholds": "https://devgateway.local/schemas/eval/gate-definition.v0.1.schema.json#/$defs/suiteThresholds",
    "gate_result_persistence": "https://devgateway.local/schemas/eval/gate-result-persistence.v0.1.schema.json#/$defs/gateResultPersistenceRecord",
    "gate_result_version_bindings": "https://devgateway.local/schemas/eval/gate-result-persistence.v0.1.schema.json#/$defs/versionBindings"
  }
}
