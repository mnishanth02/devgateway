{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devgateway.local/schemas/agent/workflow-event.v0.1.schema.json",
  "title": "DevGateway Workflow Event Contract v0.1",
  "type": "object",
  "required": [
    "contract_version",
    "workflow_event_id",
    "workflow_run_id",
    "sequence_number",
    "event_type",
    "actor_ref",
    "principal_id",
    "project_id",
    "data_class",
    "budget_scope_id",
    "policy_version",
    "registry_version",
    "trace_id",
    "trace_context_ref",
    "state_transition",
    "step_ref",
    "agent_run_ref",
    "delegation_ref",
    "tool_call_ref",
    "event_metadata_ref",
    "artifact_refs",
    "audit_refs",
    "cost_refs",
    "idempotency",
    "occurred_at"
  ],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "workflow_event_id": { "$ref": "#/$defs/nonEmptyString" },
    "workflow_run_id": { "$ref": "#/$defs/nonEmptyString" },
    "sequence_number": { "type": "integer", "minimum": 1 },
    "event_type": { "$ref": "#/$defs/eventType" },
    "actor_ref": { "$ref": "#/$defs/actorRef" },
    "principal_id": { "$ref": "#/$defs/nonEmptyString" },
    "project_id": { "$ref": "#/$defs/nonEmptyString" },
    "data_class": { "$ref": "#/$defs/dataClass" },
    "budget_scope_id": { "$ref": "#/$defs/nonEmptyString" },
    "policy_version": { "$ref": "#/$defs/nonEmptyString" },
    "registry_version": { "$ref": "#/$defs/nonEmptyString" },
    "trace_id": { "$ref": "#/$defs/nonEmptyString" },
    "trace_context_ref": { "$ref": "#/$defs/traceContextRef" },
    "state_transition": { "$ref": "#/$defs/stateTransition" },
    "step_ref": { "$ref": "#/$defs/opaqueRef" },
    "agent_run_ref": { "anyOf": [{ "$ref": "#/$defs/opaqueRef" }, { "type": "null" }] },
    "delegation_ref": { "anyOf": [{ "$ref": "#/$defs/opaqueRef" }, { "type": "null" }] },
    "tool_call_ref": { "anyOf": [{ "$ref": "#/$defs/opaqueRef" }, { "type": "null" }] },
    "event_metadata_ref": { "$ref": "#/$defs/opaqueRef" },
    "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" }, "uniqueItems": true },
    "audit_refs": { "type": "array", "items": { "$ref": "#/$defs/auditRef" }, "uniqueItems": true },
    "cost_refs": { "type": "array", "items": { "$ref": "#/$defs/costRef" }, "uniqueItems": true },
    "idempotency": { "$ref": "#/$defs/idempotencyRef" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableNonEmptyString": { "type": ["string", "null"], "minLength": 1 },
    "eventType": { "type": "string", "enum": ["workflow_created", "state_transitioned", "agent_run_started", "delegation_created", "delegation_completed", "tool_call_decided", "artifact_recorded", "budget_recorded", "audit_recorded", "workflow_completed", "workflow_failed"] },
    "workflowStatus": { "type": "string", "enum": ["created", "queued", "planning", "running", "waiting_on_child", "synthesizing", "succeeded", "failed", "cancelled", "timed_out", "denied"] },
    "dataClass": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
    "traceContextRef": {
      "type": "object",
      "required": ["trace_context_id", "span_id", "propagation_ref"],
      "properties": {
        "trace_context_id": { "$ref": "#/$defs/nonEmptyString" },
        "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "propagation_ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "actorRef": {
      "type": "object",
      "required": ["actor_type", "actor_ref", "principal_id"],
      "properties": {
        "actor_type": { "type": "string", "enum": ["system", "principal", "agent", "tool", "worker"] },
        "actor_ref": { "$ref": "#/$defs/nonEmptyString" },
        "principal_id": { "$ref": "#/$defs/nullableNonEmptyString" }
      },
      "additionalProperties": false
    },
    "stateTransition": {
      "type": "object",
      "required": ["from_status", "to_status", "transition_reason_ref"],
      "properties": {
        "from_status": { "anyOf": [{ "$ref": "#/$defs/workflowStatus" }, { "type": "null" }] },
        "to_status": { "anyOf": [{ "$ref": "#/$defs/workflowStatus" }, { "type": "null" }] },
        "transition_reason_ref": { "$ref": "#/$defs/nullableNonEmptyString" }
      },
      "additionalProperties": false
    },
    "opaqueRef": {
      "type": "object",
      "required": ["ref_id", "ref_type", "scope_ref"],
      "properties": {
        "ref_id": { "$ref": "#/$defs/nonEmptyString" },
        "ref_type": { "$ref": "#/$defs/nonEmptyString" },
        "scope_ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "idempotencyRef": {
      "type": "object",
      "required": ["idempotency_key", "scope", "dedupe_ref", "expires_at"],
      "properties": {
        "idempotency_key": { "$ref": "#/$defs/nonEmptyString" },
        "scope": { "type": "string", "enum": ["workflow", "step", "delegation", "agent_run", "tool_call", "artifact_write"] },
        "dedupe_ref": { "$ref": "#/$defs/nonEmptyString" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["artifact_id", "artifact_kind", "data_class", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmptyString" },
        "artifact_kind": { "$ref": "#/$defs/nonEmptyString" },
        "data_class": { "$ref": "#/$defs/dataClass" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "auditRef": {
      "type": "object",
      "required": ["audit_event_id", "audit_stream", "recorded_at"],
      "properties": {
        "audit_event_id": { "$ref": "#/$defs/nonEmptyString" },
        "audit_stream": { "$ref": "#/$defs/nonEmptyString" },
        "recorded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "costRef": {
      "type": "object",
      "required": ["cost_event_id", "budget_scope_id", "cost_phase", "recorded_at"],
      "properties": {
        "cost_event_id": { "$ref": "#/$defs/nonEmptyString" },
        "budget_scope_id": { "$ref": "#/$defs/nonEmptyString" },
        "cost_phase": { "type": "string", "enum": ["estimate", "reservation", "settlement", "release", "reconciliation"] },
        "recorded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
