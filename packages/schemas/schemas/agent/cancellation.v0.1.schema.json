{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devgateway.local/schemas/agent/cancellation.v0.1.schema.json",
  "title": "DevGateway Cancellation Record Contract v0.1",
  "type": "object",
  "required": [
    "contract_version",
    "cancellation_id",
    "workflow_run_id",
    "task_id",
    "requester_principal_id",
    "cancellation_reason_ref",
    "propagation_state",
    "target_ref",
    "cancellation_deadline",
    "budget_release_refs",
    "terminal_artifact_refs",
    "manual_review_item_ids",
    "principal_id",
    "project_id",
    "data_class",
    "budget_scope_id",
    "policy_version",
    "registry_version",
    "trace_id",
    "trace_context_ref",
    "idempotency",
    "audit_refs",
    "requested_at",
    "completed_at"
  ],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "cancellation_id": { "$ref": "#/$defs/nonEmptyString" },
    "workflow_run_id": { "$ref": "#/$defs/nonEmptyString" },
    "task_id": { "$ref": "#/$defs/nonEmptyString" },
    "requester_principal_id": { "$ref": "#/$defs/nonEmptyString" },
    "cancellation_reason_ref": { "$ref": "#/$defs/opaqueRef" },
    "propagation_state": { "$ref": "#/$defs/propagationState" },
    "target_ref": { "$ref": "#/$defs/cancellationTargetRef" },
    "cancellation_deadline": { "type": "string", "format": "date-time" },
    "budget_release_refs": { "type": "array", "items": { "$ref": "#/$defs/costRef" }, "uniqueItems": true },
    "terminal_artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" }, "uniqueItems": true },
    "manual_review_item_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
    "principal_id": { "$ref": "#/$defs/nonEmptyString" },
    "project_id": { "$ref": "#/$defs/nonEmptyString" },
    "data_class": { "$ref": "#/$defs/dataClass" },
    "budget_scope_id": { "$ref": "#/$defs/nonEmptyString" },
    "policy_version": { "$ref": "#/$defs/nonEmptyString" },
    "registry_version": { "$ref": "#/$defs/nonEmptyString" },
    "trace_id": { "$ref": "#/$defs/nonEmptyString" },
    "trace_context_ref": { "$ref": "#/$defs/traceContextRef" },
    "idempotency": { "$ref": "#/$defs/idempotencyRef" },
    "audit_refs": { "type": "array", "items": { "$ref": "#/$defs/auditRef" }, "uniqueItems": true },
    "requested_at": { "type": "string", "format": "date-time" },
    "completed_at": { "$ref": "#/$defs/nullableDateTime" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableDateTime": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "dataClass": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
    "propagationState": {
      "type": "string",
      "enum": [
        "requested",
        "propagating",
        "pending_manual_review",
        "unwinding",
        "releasing_reservations",
        "completed",
        "partially_completed",
        "partially_completed_manual_review"
      ]
    },
    "cancellationTargetRef": {
      "type": "object",
      "required": ["workflow_run_id", "step_ids", "delegation_ids", "agent_run_ids", "tool_call_ids"],
      "properties": {
        "workflow_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "step_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "delegation_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "agent_run_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "tool_call_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "opaqueRef": {
      "type": "object",
      "required": ["ref_id", "ref_type", "scope_ref"],
      "properties": {
        "ref_id": { "$ref": "#/$defs/nonEmptyString" },
        "ref_type": { "$ref": "#/$defs/nonEmptyString" },
        "scope_ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "costRef": {
      "type": "object",
      "required": ["cost_event_id", "budget_scope_id", "cost_phase", "recorded_at"],
      "properties": {
        "cost_event_id": { "$ref": "#/$defs/nonEmptyString" },
        "budget_scope_id": { "$ref": "#/$defs/nonEmptyString" },
        "cost_phase": { "type": "string", "enum": ["estimate", "reservation", "settlement", "release", "reconciliation"] },
        "recorded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["artifact_id", "artifact_kind", "data_class", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmptyString" },
        "artifact_kind": { "$ref": "#/$defs/nonEmptyString" },
        "data_class": { "$ref": "#/$defs/dataClass" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "traceContextRef": {
      "type": "object",
      "required": ["trace_context_id", "span_id", "propagation_ref"],
      "properties": {
        "trace_context_id": { "$ref": "#/$defs/nonEmptyString" },
        "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "propagation_ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "auditRef": {
      "type": "object",
      "required": ["audit_event_id", "audit_stream", "recorded_at"],
      "properties": {
        "audit_event_id": { "$ref": "#/$defs/nonEmptyString" },
        "audit_stream": { "$ref": "#/$defs/nonEmptyString" },
        "recorded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "idempotencyRef": {
      "type": "object",
      "required": ["idempotency_key", "scope", "dedupe_ref", "expires_at"],
      "properties": {
        "idempotency_key": { "$ref": "#/$defs/nonEmptyString" },
        "scope": { "type": "string", "enum": ["workflow", "step", "delegation", "agent_run", "tool_call", "artifact_write", "cancellation"] },
        "dedupe_ref": { "$ref": "#/$defs/nonEmptyString" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
