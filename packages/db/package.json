{
  "name": "@devgateway/db",
  "version": "0.0.0",
  "private": true,
  "description": "Placeholder package for operational database schema and migration conventions.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:check": "drizzle-kit check && node --experimental-strip-types src/check.ts",
    "db:check:database": "drizzle-kit check && node --experimental-strip-types src/check.ts --database",
    "db:check:offline": "drizzle-kit check && node --experimental-strip-types src/check.ts --offline",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
