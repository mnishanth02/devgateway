# DevGateway environment example
# Secret-free template only. Replace placeholder values in local or Railway variables.
# Classification legend: public, internal, sensitive, secret.

# Runtime / environment (public/internal)
NODE_ENV=development
APP_ENV=development
RAILWAY_ENVIRONMENT=development
PRODUCTION_PROVISIONING_ENABLED=false
PRODUCTION_DEPLOY_APPROVAL_REQUIRED=true

# Better Auth (public/secret)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<secret:generate-with-openssl-rand-base64-32>
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_ADMIN_BOOTSTRAP_ENABLED=false
AUTH_ADMIN_BOOTSTRAP_EMAIL=<internal:admin@example.invalid>

# Databases (secret)
OPERATIONAL_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/devgateway_operational
KNOWLEDGE_DATABASE_URL=postgresql://<user>:<password>@localhost:5433/devgateway_knowledge
DATABASE_MIGRATION_URL=postgresql://<migration-user>:<password>@localhost:5432/devgateway_operational
DATABASE_READONLY_URL=postgresql://<readonly-user>:<password>@localhost:5432/devgateway_operational

# Redis (secret/internal)
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAMESPACE=devgateway:queue:local
REDIS_RATE_LIMIT_NAMESPACE=devgateway:ratelimit:local

# Bifrost and provider routing (secret/internal)
BIFROST_BASE_URL=http://localhost:8080
BIFROST_ADMIN_TOKEN=<secret:bifrost-admin-token>
BIFROST_VIRTUAL_KEY_SEED=<secret:virtual-key-seed>
BIFROST_CONFIG_PATH=infra/bifrost/bifrost.config.example.yaml
BIFROST_ROUTE_CONFIG_VERSION=local
BIFROST_BREAK_GLASS_ENABLED=false
OPENAI_API_KEY=<secret:provider-key-placeholder>
ANTHROPIC_API_KEY=<secret:provider-key-placeholder>

# GitHub App (secret/internal)
GITHUB_APP_ID=<internal:github-app-id>
GITHUB_APP_INSTALLATION_ID=<internal:github-app-installation-id>
GITHUB_APP_PRIVATE_KEY_BASE64=<secret:base64-pem-placeholder>
GITHUB_APP_WEBHOOK_SECRET=<secret:webhook-secret-placeholder>

# Object storage / S3-compatible bucket (secret/internal)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=devgateway-local-artifacts
S3_REGION=auto
S3_ACCESS_KEY_ID=<secret:s3-access-key-placeholder>
S3_SECRET_ACCESS_KEY=<secret:s3-secret-key-placeholder>
S3_FORCE_PATH_STYLE=true

# Observability (public/internal/secret)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=<secret:otlp-header-placeholder>
OTEL_SERVICE_NAME=devgateway-local
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
TRACE_SAMPLE_RATE=1.0
METRICS_EXPORT_MODE=local

# Eval gates (internal)
EVAL_DATASET_PATH=evals/fixtures
EVAL_GATE_MODE=fixture
EVAL_ARTIFACT_BUCKET=devgateway-local-artifacts
EVAL_PROVIDER_MODE=fixture
EVAL_SMOKE_ENABLED=true

# Application encryption and audit correlation (secret/internal)
APP_ENCRYPTION_KEY_BASE64=<secret:32-byte-base64-key-placeholder>
CREDENTIAL_KEY_VERSION=local-v1
CREDENTIAL_ROTATION_REQUIRED=false
AUDIT_CORRELATION_SALT=<secret:audit-salt-placeholder>
